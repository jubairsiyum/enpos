							]
						}
					},
					"response": []
				},
				{
					"name": "Get All 41 Permission Groups",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "X-Business",
								"value": "{{business_id}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/shop/roles/permissions",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shop",
								"roles",
								"permissions"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Custom Role",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "X-Business",
								"value": "{{business_id}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Store Manager\",\n    \"permissions\": [\n        \"shop.users.view\",\n        \"shop.products.view\",\n        \"shop.pos.view\",\n        \"shop.sell.view_all\"\n    ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/shop/roles",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shop",
								"roles"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Sales Commission Agents",
