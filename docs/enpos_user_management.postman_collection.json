{
	"info": {
		"_postman_id": "enpos-user-management-api",
		"name": "enPOS — User Management API",
		"description": "API collection for testing User Management (Users, Roles, Permissions, Sales Commission Agents) with automatic token management.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8003/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "business_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth",
			"item": [
				{
					"name": "Login (Owner) — Auto sets Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    console.log('Token saved:', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"owner@demo.test\",\n    \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Current User (Me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Users",
			"item": [
				{
					"name": "List Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "X-Business",
								"value": "{{business_id}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/shop/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shop",
								"users"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "X-Business",
								"value": "{{business_id}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"prefix\": \"Mr\",\n    \"first_name\": \"John\",\n    \"last_name\": \"Doe\",\n    \"email\": \"johndoe@example.com\",\n    \"username\": \"johndoe123\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\",\n    \"role\": \"cashier\",\n    \"is_active\": true,\n    \"allow_login\": true,\n    \"commission_rate\": 5.0,\n    \"phone\": \"01711223344\",\n    \"permanent_address\": \"Dhaka, Bangladesh\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/shop/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shop",
								"users"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Roles & Permissions",
			"item": [
				{
