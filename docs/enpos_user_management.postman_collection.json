						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "X-Business",
								"value": "{{business_id}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"prefix\": \"Mr\",\n    \"first_name\": \"Rahim\",\n    \"last_name\": \"Agent\",\n    \"email\": \"rahim.agent@example.com\",\n    \"phone\": \"01811223344\",\n    \"permanent_address\": \"Dhaka, Bangladesh\",\n    \"commission_rate\": 7.5\n}"
						},
						"url": {
							"raw": "{{base_url}}/shop/sales-commission-agents",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"shop",
								"sales-commission-agents"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
